# ─────────────────────────────────────────────────────────────────────────────
# SourcingOS — environment variables (next-public/)
# Copy to .env.local for development. NEVER commit real values.
#
# Vercel provider testing workflow:
#   1. Add paid provider keys to the Preview environment first.
#   2. Keep ALLOW_PREVIEW_BYPASS=false whenever any paid provider key is present.
#   3. Redeploy the preview so the new environment values are loaded.
#   4. Verify /api/candidate-data/status reports the intended executable lanes,
#      then run a real search and confirm provider telemetry before trusting a key.
#   5. Add provider keys to Production only after the release is explicitly approved.
#
# Key presence means configured/executable, not authenticated with the vendor.
# A provider is operational only after a real request succeeds.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site identity (required for correct OG/canonical/sitemap URLs) ───────────
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# ── Supabase (required for auth + durable persistence) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only. Bypasses RLS — handle with extreme care.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth behavior ─────────────────────────────────────────────────────────────
# FAIL-CLOSED default: when Supabase is unconfigured, protected routes return
# 503. Set to 'true' ONLY for local dev or access-protected preview deploys
# that carry NO paid provider keys.
ALLOW_PREVIEW_BYPASS=false

# ── Internal integrity secrets ────────────────────────────────────────────────
OBSERVATION_SIGNING_SECRET=

# ── Rate limiting ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_DISABLED=false

# ── AI provider (server-only; never exposed to the browser) ──────────────────
ANTHROPIC_API_KEY=
# Optional generic alias + model override.
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_MODEL=
# Dedicated improvement-fleet model override. Falls back to AI_PROVIDER_MODEL,
# then claude-sonnet-4-6.
AGENT_FLEET_MODEL=claude-sonnet-4-6

# ── Technical Talent Graph sources (server-only) ──────────────────────────────
GITHUB_API_TOKEN=

# ── Professional candidate-data search providers (server-only) ───────────────
PEARCH_API_KEY=
PDL_API_KEY=
CORESIGNAL_API_KEY=
DATAVERTEX_API_KEY=
CONTACTOUT_API_KEY=
SIGNALHIRE_API_KEY=
LINKUP_API_KEY=
EXA_API_KEY=
OPENWEBNINJA_API_KEY=

# ── Contact resolution / verification providers (server-only) ────────────────
ANYMAILFINDER_API_KEY=
HUNTER_API_KEY=
TOMBA_API_KEY=
TOMBA_SECRET_KEY=

# ── Future/queued provider keys ───────────────────────────────────────────────
# APOLLO_API_KEY=
# LUSHA_API_KEY=
# COMPANYENRICH_API_KEY=
# CRUSTDATA_API_KEY=
# ZOOMINFO_API_KEY=
# SNOV_API_KEY=

# ── V40.7b governed 50-agent capability fleet ───────────────────────────────
# Vercel Marketplace integrations normally inject these server-side keys.
# Keep exact names; never add NEXT_PUBLIC_ prefixes.
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# The Marketplace Exa resource may be installed with this custom prefix while
# the existing production Exa adapter continues to use EXA_API_KEY.
VERCEL_EXA_EXA_API_KEY=

# Experimental provider evaluation is double-gated and defaults closed. The
# existing EXA_API_KEY lane may be used by Search Intelligence without this
# experimental gate; Vercel Exa, Firecrawl, and Parallel require it.
AGENT_FLEET_EXPERIMENTAL_PROVIDERS=false
AGENT_FLEET_PROVIDER_VERCEL_EXA=false
AGENT_FLEET_PROVIDER_FIRECRAWL=false
AGENT_FLEET_PROVIDER_PARALLEL=false
AGENT_FLEET_PROVIDER_TAVILY=false
AGENT_FLEET_PROVIDER_APIFY=false

# These flags never authorize LinkedIn/account-gated scraping, provider
# purchasing, unattended contact harvesting, or V40.5 Resume/CV queue access.

# ── Jobs ingestion (optional public sources) ──────────────────────────────────
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# ── Scheduled refresh ─────────────────────────────────────────────────────────
CRON_SECRET=

# ── Demo data (keep false in production) ──────────────────────────────────────
NEXT_PUBLIC_ENABLE_DEMO_SOURCE_RESULTS=false
