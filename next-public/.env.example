# ─────────────────────────────────────────────────────────────────────────────
# SourcingOS — environment variables (next-public/)
# Copy to .env.local for development. NEVER commit real values.
#
# Vercel provider testing workflow:
#   1. Add paid provider keys to the Preview environment first.
#   2. Keep ALLOW_PREVIEW_BYPASS=false whenever any paid provider key is present.
#   3. Redeploy the preview so the new environment values are loaded.
#   4. Verify /api/candidate-data/status reports the intended executable lanes,
#      then run a real search and confirm provider telemetry before trusting a key.
#   5. Add provider keys to Production only after the V36.x release is explicitly
#      approved for production deployment.
#
# Key presence means configured/executable, not authenticated with the vendor.
# A provider is operational only after a real request succeeds.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site identity (required for correct OG/canonical/sitemap URLs) ───────────
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# ── Supabase (required for auth + durable persistence) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only. Bypasses RLS — handle with extreme care.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth behavior ─────────────────────────────────────────────────────────────
# FAIL-CLOSED default: when Supabase is unconfigured, protected routes return
# 503. Set to 'true' ONLY for local dev or access-protected preview deploys
# that carry NO paid provider keys.
ALLOW_PREVIEW_BYPASS=false

# ── Rate limiting (strongly recommended in production) ────────────────────────
# Upstash Redis REST credentials (Vercel Marketplace → Upstash).
# Without these, limits fall back to per-instance in-memory (best effort only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 'true' only in automated tests.
# RATE_LIMIT_DISABLED=false

# ── AI provider (server-only; never exposed to the browser) ──────────────────
ANTHROPIC_API_KEY=
# Optional generic alias + model override.
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_MODEL=

# ── Technical Talent Graph sources (server-only) ──────────────────────────────
# Optional. GitHub V2 remains usable without a token, but anonymous mode uses a
# much smaller request/people budget and cannot establish contribution-history
# depth. Use a least-privilege token with public-read access only.
GITHUB_API_TOKEN=

# ── Professional candidate-data search providers (server-only) ───────────────
# Search adapters execute only when their exact key below is configured.
# Search runs do not reveal contact information by default.
PEARCH_API_KEY=
PDL_API_KEY=
CORESIGNAL_API_KEY=
DATAVERTEX_API_KEY=
CONTACTOUT_API_KEY=
SIGNALHIRE_API_KEY=
LINKUP_API_KEY=
EXA_API_KEY=

# OpenWeb Ninja is registered for public-web corroboration/contact work, but its
# person-grounded executable adapter is still gated until that contract is wired.
OPENWEBNINJA_API_KEY=

# ── Contact resolution / verification providers (server-only) ────────────────
# Paid/per-lookup operations stay behind auth + rate limits and are explicit.
# PDL, DataVertex and SignalHire reuse the keys above.
ANYMAILFINDER_API_KEY=
HUNTER_API_KEY=
TOMBA_API_KEY=
TOMBA_SECRET_KEY=

# ── Future/queued provider keys ───────────────────────────────────────────────
# Add only when the corresponding adapter is implemented; the product must never
# imply that a provider executed simply because a credential exists.
# APOLLO_API_KEY=
# LUSHA_API_KEY=
# COMPANYENRICH_API_KEY=
# CRUSTDATA_API_KEY=
# ZOOMINFO_API_KEY=
# SNOV_API_KEY=

# ── Jobs ingestion (optional public sources) ──────────────────────────────────
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# ── Scheduled refresh ─────────────────────────────────────────────────────────
# REQUIRED for /api/candidates/cron-refresh — the route returns 503 without it.
CRON_SECRET=

# ── Demo data (keep false in production) ──────────────────────────────────────
NEXT_PUBLIC_ENABLE_DEMO_SOURCE_RESULTS=false
